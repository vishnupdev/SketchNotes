{
  "name": "sketchnotes",
  "version": "1.0.0",
  "private": true,
  "description": "Sketchnotes — a canvas sketching & note app. Next.js + Tailwind + Zustand + TanStack Query.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-precache.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:registry": "node scripts/check-app-registry.mjs",
    "check:sw": "node scripts/check-sw-version.mjs",
    "check:themes": "node scripts/audit-theme-contrast.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:registry && npm run check:themes && npm run check:sw",
    "audit": "node scripts/audit-lighthouse.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "mermaid": "^11.17.2",
    "next": "^16.2.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lighthouse": "^13.4.1",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  }
}
